generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  // Workspace role: ADMIN | MANAGER | EDITOR | CLIENT (see src/lib/roles.ts).
  // Stored as TEXT because SQLite has no enum; parsed strictly on read.
  role          String    @default("ADMIN")
  timezone      String    @default("Europe/Oslo")
  accounts      Account[]
  sessions      Session[]

  // SocialOrc relations
  socialAccounts  SocialAccount[]
  posts           Post[]
  mediaAssets     MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Social platform accounts (LinkedIn, X, Instagram, Facebook, TikTok, YouTube)
model SocialAccount {
  id              String   @id @default(cuid())
  userId          String
  platform        Platform
  platformUserId  String
  platformUsername String?
  displayName     String?
  profileImageUrl String?
  
  // Encrypted OAuth tokens
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  
  /** Platform-specific metadata (JSON) */
  metadata        Json?

  /** Platform account kind, e.g. tiktok_creator, youtube_channel, facebook_page. */
  accountType     String?
  /** Parent resource the account hangs off (Facebook Page, LinkedIn organization). */
  externalParentId String?
  /** Granted OAuth scopes, space separated exactly as the provider returned them. */
  scopes          String?
  /** Last computed capability report, cached so the UI can answer without a refresh. */
  capabilities    Json?
  /** Expiry of the refresh token itself (TikTok: up to 365 days). */
  refreshTokenExpiresAt DateTime?
  /** Set when the user disconnects; kept so history and analytics survive. */
  disconnectedAt  DateTime?
  
  isActive        Boolean  @default(true)
  lastSyncAt      DateTime?
  /** Last connector failure, kept so the UI can explain and offer a reconnect. */
  lastError       String?
  /** True when the connector needs human re-authorisation (bad/expired/insufficient credentials). */
  needsReconnect  Boolean  @default(false)
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts           Post[]
  publishingJobs  PublishingJob[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([platform, platformUserId])
  @@index([userId])
  @@index([platform])
}

enum Platform {
  LINKEDIN
  TWITTER
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  TELEGRAM
}

// Post/Content model with full workflow states
model Post {
  id              String      @id @default(cuid())
  userId          String
  socialAccountId String?
  
  // Content
  title           String?
  content         String
  platformContent Json?       // Platform-specific formatted content
  
  // Status workflow: draft → pending_approval → approved → scheduled → publishing → published | failed
  status          PostStatus  @default(DRAFT)
  
  // Scheduling
  scheduledFor    DateTime?
  publishedAt     DateTime?
  
  // Platform targeting
  platform        Platform
  
  // Approval workflow
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  
  // Publishing results
  platformPostId  String?
  platformPostUrl String?
  errorMessage    String?
  retryCount      Int         @default(0)
  lastRetryAt     DateTime?
  
  // Media attachments
  mediaAssets     PostMedia[]
  
  // Relations
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([platform])
  @@index([scheduledFor])
  @@index([socialAccountId])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// Media assets (images, videos)
model MediaAsset {
  id          String    @id @default(cuid())
  userId      String
  
  filename    String
  mimeType    String
  size        Int
  url         String
  blobPath    String?
  
  // Image/video metadata
  width       Int?
  height      Int?
  duration    Int?      // Video duration in seconds
  
  posts       PostMedia[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// Junction table for Post-Media relationship
model PostMedia {
  id          String     @id @default(cuid())
  postId      String
  mediaAssetId String
  order       Int        @default(0)
  
  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  
  @@unique([postId, mediaAssetId])
  @@index([postId])
  @@index([mediaAssetId])
}

// Job queue for scheduled posts
/**
 * One row per publish attempt against one connected account.
 *
 * The queue owns *when*; the provider owns *how*. Keeping both out of `Post`
 * means a retry, a draft upload and a direct post can all point at the same
 * piece of content without rewriting it, and `idempotencyKey` guarantees a
 * retried job cannot post twice.
 */
model PublishingJob {
  id              String    @id @default(cuid())
  userId          String
  socialAccountId String
  /** Optional link back to the SocialOrc content item being published. */
  postId          String?
  platform        Platform
  /** direct | draft_upload — see src/lib/social/types.ts */
  publishMethod   String
  /** draft | scheduled | queued | uploading | processing | published | failed | cancelled */
  status          String
  scheduledAt     DateTime?
  /** Caller-supplied key; the unique index is what makes retries safe. */
  idempotencyKey  String?   @unique
  /** Platform-side id (TikTok publish_id, YouTube video id, …). */
  externalPostId  String?
  attemptCount    Int       @default(0)
  lastErrorCode   String?
  lastErrorMessage String?
  /** Operator-only technical detail: never serialized to the browser. */
  lastErrorDetail String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledAt])
  @@index([userId])
  @@index([socialAccountId])
}

model ScheduledJob {
  id          String        @id @default(cuid())
  postId      String        @unique
  status      JobStatus     @default(PENDING)
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  errorMessage String?
  attempts    Int           @default(0)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Platform character limits and constraints
model PlatformConstraints {
  id              String   @id @default(cuid())
  platform        Platform @unique
  maxTextLength   Int
  maxMediaCount   Int
  maxVideoSizeMb  Int?
  maxImageSizeMb  Int?
  supportedMediaTypes Json  // Array of MIME types
  additionalRules Json?    // Platform-specific rules
  
  updatedAt       DateTime @updatedAt
}
