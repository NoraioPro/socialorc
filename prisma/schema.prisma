generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("ADMIN")
  timezone      String    @default("Europe/Oslo")
  headline      String?
  bio           String?
  location      String?
  website       String?
  coverImageUrl String?
  accounts      Account[]
  sessions      Session[]

  // SocialOrc relations
  socialAccounts  SocialAccount[]
  posts           Post[]
  mediaAssets     MediaAsset[]
  brains          Brain[]
  feedReactions   FeedReaction[]
  feedComments    FeedComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A project: the container social accounts are connected into. A user can
/// run several brains (e.g. one per brand/client), each with its own
/// independent set of platform connections — connecting "LinkedIn" under one
/// brain never touches another brain's LinkedIn connection.
model Brain {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// The brain shown by default (e.g. auto-created on first use).
  isDefault Boolean  @default(false)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Social platform accounts (LinkedIn, X, Instagram, Facebook, TikTok, YouTube)
model SocialAccount {
  id              String   @id @default(cuid())
  userId          String
  /// Which brain (project) this connection belongs to. Required: every
  /// connection lives inside exactly one brain, never shared across brains.
  brainId         String
  platform        Platform
  platformUserId  String
  platformUsername String?
  displayName     String?
  profileImageUrl String?
  
  // Encrypted OAuth tokens
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  
  // Platform-specific metadata (JSON)
  metadata        Json?
  
  isActive        Boolean  @default(true)
  lastSyncAt      DateTime?
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brain           Brain    @relation(fields: [brainId], references: [id], onDelete: Cascade)
  posts           Post[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([platform, platformUserId])
  @@index([userId])
  @@index([brainId])
  @@index([platform])
}

enum Platform {
  LINKEDIN
  TWITTER
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  TELEGRAM
}

// Post/Content model with full workflow states
model Post {
  id              String      @id @default(cuid())
  userId          String
  socialAccountId String?
  
  // Content
  title           String?
  content         String
  platformContent Json?       // Platform-specific formatted content
  
  // Status workflow: draft → pending_approval → approved → scheduled → publishing → published | failed
  status          PostStatus  @default(DRAFT)
  
  // Scheduling
  scheduledFor    DateTime?
  publishedAt     DateTime?
  
  // Platform targeting
  platform        Platform
  
  // Approval workflow
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  
  // Publishing results
  platformPostId  String?
  platformPostUrl String?
  errorMessage    String?
  retryCount      Int         @default(0)
  lastRetryAt     DateTime?
  
  // Media attachments
  mediaAssets     PostMedia[]
  
  // Relations
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  feedReactions   FeedReaction[]
  feedComments    FeedComment[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([platform])
  @@index([scheduledFor])
  @@index([socialAccountId])
}

model FeedReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String   @default("LIKE")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model FeedComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// Media assets (images, videos)
model MediaAsset {
  id          String    @id @default(cuid())
  userId      String
  
  filename    String
  mimeType    String
  size        Int
  url         String
  blobPath    String?
  
  // Image/video metadata
  width       Int?
  height      Int?
  duration    Int?      // Video duration in seconds
  
  posts       PostMedia[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// Junction table for Post-Media relationship
model PostMedia {
  id          String     @id @default(cuid())
  postId      String
  mediaAssetId String
  order       Int        @default(0)
  
  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  
  @@unique([postId, mediaAssetId])
  @@index([postId])
  @@index([mediaAssetId])
}

// Job queue for scheduled posts
model ScheduledJob {
  id          String        @id @default(cuid())
  postId      String        @unique
  status      JobStatus     @default(PENDING)
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  errorMessage String?
  attempts    Int           @default(0)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Platform character limits and constraints
model PlatformConstraints {
  id              String   @id @default(cuid())
  platform        Platform @unique
  maxTextLength   Int
  maxMediaCount   Int
  maxVideoSizeMb  Int?
  maxImageSizeMb  Int?
  supportedMediaTypes Json  // Array of MIME types
  additionalRules Json?    // Platform-specific rules
  
  updatedAt       DateTime @updatedAt
}
