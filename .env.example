# SocialOrc environment.
#
# Copy to .env for local development, or set these in the Vercel project for a
# deployment. .env itself is gitignored; this file is the record of what the app
# needs. See docs/PRODUCTION.md for how the production values differ.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# The scheme selects the Prisma schema, the migrations directory AND the driver
# adapter, so this single value decides which database the app talks to.
#
#   postgresql://...  -> Supabase / Postgres      (production)
#   file:./dev.db     -> sqlite                   (local dev only)
#
# LOCAL:      the session pooler, port 5432
# PRODUCTION: the TRANSACTION pooler, port 6543, for serverless runtimes:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations must instead use port 5432 - PgBouncer's transaction mode cannot
# run DDL. Verify whichever you use; do not assume.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Must be the exact origin the browser uses, or sign-in fails with MissingCSRF.
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Real, unique, random values in production. Changing TOKEN_ENCRYPTION_KEY
# invalidates every stored social token - accounts must be reconnected.
NEXTAUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Vercel sends this to the cron endpoint. Must match the deployed value or the
# publish worker is unauthenticated (or rejects Vercel).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Google sign-in (optional - appears only when BOTH halves are set)
# ---------------------------------------------------------------------------
# Redirect URIs to register:
#   Google   -> <APP_URL>/api/auth/callback/google
#   Facebook -> <APP_URL>/api/auth/callback/facebook
# Facebook reuses the connector's Meta app credentials below, so one Meta app
# serves both sign-in and publishing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Who may register
# ---------------------------------------------------------------------------
# The first account always gets in and becomes the workspace owner (ADMIN).
# After that, registration is invite-only unless opened deliberately:
#
#   ALLOW_PUBLIC_SIGNUP=true     open registration to anyone
#   SIGNUP_ALLOWLIST=            comma-separated invites, exact addresses
#                                and/or whole domains
#                                e.g. "me@x.com,@noraiopro.com"
#
# Accounts after the first get EDITOR (least privilege) - see roles.ts. Override
# the role itself with SIGNUP_ROLE.
ALLOW_PUBLIC_SIGNUP=false
SIGNUP_ALLOWLIST=
SIGNUP_ROLE=

# ---------------------------------------------------------------------------
# Storage (required for image/media posts)
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Social platforms (required - the product publishes nothing without them)
# ---------------------------------------------------------------------------
# Only configured platforms are offered. Register <APP_URL>/api/social/<platform>/callback
# as the redirect URI in each portal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# AI (optional - features degrade without it)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# MUST be unset or "false" in production. When true the app fakes publishing:
# posts are marked published without anything leaving the machine.
MOCK_SOCIAL_ADAPTERS=false
