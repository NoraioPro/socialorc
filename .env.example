# SocialOrc environment.
#
# Copy to .env for local development, or set these in the Vercel project for a
# deployment. .env itself is gitignored; this file is the record of what the app
# needs. See docs/PRODUCTION.md for how the production values differ.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# The scheme selects the Prisma schema, the migrations directory AND the driver
# adapter, so this single value decides which database the app talks to.
#
#   postgresql://...  -> Supabase / Postgres      (production)
#   file:./dev.db     -> sqlite                   (local dev only)
#
# LOCAL:      the session pooler, port 5432
# PRODUCTION: the TRANSACTION pooler, port 6543, for serverless runtimes:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations must instead use port 5432 - PgBouncer's transaction mode cannot
# run DDL. Verify whichever you use; do not assume.
DATABASE_URL=

# DDL-capable connection, used ONLY by migrations at deploy time (see
# scripts/migrate-deploy.mjs). In production set this to the session pooler on
# port 5432. Leave it unset locally and the build skips migrations.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Must be the exact origin the browser uses, or sign-in fails with MissingCSRF.
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Real, unique, random values in production. Changing TOKEN_ENCRYPTION_KEY
# invalidates every stored social token - accounts must be reconnected.
NEXTAUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Vercel sends this to the cron endpoint. Must match the deployed value or the
# publish worker is unauthenticated (or rejects Vercel).
CRON_SECRET=

# Signs the OAuth state cookie. Optional: falls back to NEXTAUTH_SECRET. Set it
# separately so rotating one secret does not break the other.
OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# Google sign-in (optional - appears only when BOTH halves are set)
# ---------------------------------------------------------------------------
# Redirect URIs to register:
#   Google   -> <APP_URL>/api/auth/callback/google
#   Facebook -> <APP_URL>/api/auth/callback/facebook
# Facebook reuses the connector's Meta app credentials below, so one Meta app
# serves both sign-in and publishing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Who may register
# ---------------------------------------------------------------------------
# The first account always gets in and becomes the workspace owner (ADMIN).
# After that, registration is invite-only unless opened deliberately:
#
#   ALLOW_PUBLIC_SIGNUP=true     open registration to anyone
#   SIGNUP_ALLOWLIST=            comma-separated invites, exact addresses
#                                and/or whole domains
#                                e.g. "me@x.com,@noraiopro.com"
#
# Accounts after the first get EDITOR (least privilege) - see roles.ts. Override
# the role itself with SIGNUP_ROLE.
ALLOW_PUBLIC_SIGNUP=false
SIGNUP_ALLOWLIST=
SIGNUP_ROLE=

# ---------------------------------------------------------------------------
# Storage (REQUIRED in production for any image/media post)
# ---------------------------------------------------------------------------
# Without a Blob token, uploads in production are REFUSED with
# 503 {"code":"MEDIA_STORAGE_NOT_CONFIGURED"} rather than being stored as a
# base64 `data:` URL. A data URL cannot be fetched by a social API, so such an
# asset could never be published.
#
# In development the base64 fallback is kept so local flows work without a Blob
# store. Those assets are not publishable.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Social platforms (required - the product publishes nothing without them)
# ---------------------------------------------------------------------------
# Only configured platforms are offered. Register <APP_URL>/api/social/<platform>/callback
# as the redirect URI in each portal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Telegram: the bot token enables the platform. TELEGRAM_CHAT_ID is an optional
# prefill for the connect form only. It is never used as a publishing destination;
# each connected account publishes to its own chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# AI (REQUIRED for AI generation in production)
# ---------------------------------------------------------------------------
# Production with no key REFUSES generation with
# 503 {"code":"AI_NOT_CONFIGURED"} instead of returning mock text: synthetic
# content is indistinguishable from a real completion once it reaches the UI.
# Development still gets mock output, flagged as mock (`usedMock: true`).
OPENAI_API_KEY=

# Optional provider overrides. The model is never hard-coded.
# OPENAI_MODEL defaults to gpt-4o-mini; OPENAI_BASE_URL to https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_BASE_URL=

# Alternative key read by the Brand Brain provider (checked after OPENAI_API_KEY).
AI_API_KEY=

# Embedding model for Brand Brain knowledge sources (Settings → Brand Brain →
# Knowledge). Called with the account's OWN key and base URL; defaults to
# text-embedding-3-small. With no key, sources are indexed for keyword (BM25)
# search instead, and the UI labels them as such.
AI_EMBED_MODEL=

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# MUST be unset or "false" in production. When true the app fakes publishing:
# posts are marked published without anything leaving the machine.
#
# This flag only applies OUTSIDE production. `getAdapter` gates every mock on
# NODE_ENV, so a stale MOCK_SOCIAL_ADAPTERS=true left in a production environment
# can no longer fake a publish — an unconfigured platform fails with
# PLATFORM_NOT_CONFIGURED and the post is never marked PUBLISHED.
MOCK_SOCIAL_ADAPTERS=false

# Team features (invitations, role changes, Team/Permissions panels, Social Timeline)
# are OFF for the single-user MVP. Set to "true" to enable; the API refuses them
# otherwise. See src/lib/features.ts.
NEXT_PUBLIC_TEAMS_ENABLED=
